+	/// <summary>
+	/// The pointer's current position, in the coordinates the GUI's own mouse events use, for
+	/// synthesizing an event that the input system is not going to send.
+	///
+	/// InputData is the source rather than Mouse.GetState because that is where every real
+	/// MouseEventArgs comes from - see InputData.UpdateNewState - so a synthesized one agrees with
+	/// them even if the two ever stop being the same numbers.
+	/// </summary>
+	private MouseEventArgs CurrentMouseEventArgs()
+	{
+		MouseEventArgs args = new MouseEventArgs();
+		if (guiManager != null && guiManager.InputData != null)
+		{
+			args.Position = new Point(guiManager.InputData.mouseX, guiManager.InputData.mouseY);
+		}
+		return args;
+	}
 
